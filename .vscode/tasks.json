{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" testClasses",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$java"
      ]
    },
    {
      "label": "build (full)",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" build",
      "group": "build",
      "problemMatcher": [
        "$java"
      ]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$java"
      ]
    },
    {
      "label": "test (debug)",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" test --debug-jvm",
      "group": "test",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Listening for transport dt_socket",
            "endsPattern": "Listening for transport dt_socket"
          }
        }
      ]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" clean",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" spotlessApply",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "verify format",
      "type": "shell",
      "command": "sh .vscode/gradlew-of-file.sh \"${file}\" spotlessCheck",
      "group": "build",
      "problemMatcher": [
        "$java"
      ]
    },
    {
      "label": "Install All Recommended Extensions",
      "type": "shell",
      "command": "node -e \"console.log(JSON.parse(require('fs').readFileSync('./.vscode/extensions.json')).recommendations.join('\\n'))\" | xargs -L 1 code --install-extension"
    }
  ]
}
