#!/usr/bin/env sh
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.java')
[ -z "$staged" ] && exit 0

builds=$(printf '%s\n' "$staged" | while IFS= read -r file; do
  directory=$(dirname "$file")
  while [ "$directory" != . ] && [ ! -f "$directory/gradlew" ]; do
    directory=$(dirname "$directory")
  done
  if [ "$directory" != . ]; then
    echo "$directory"
  fi
done | sort -u)

hashes() {
  printf '%s\n' "$staged" | while IFS= read -r file; do
    echo "$(git hash-object -- "$file") $file"
  done
}

before=$(hashes)

for build in $builds; do
  echo "pre-commit: formatting $build with Spotless..."
  (cd "$build" && ./gradlew spotlessApply --quiet)
done

after=$(hashes)
[ "$before" = "$after" ] && exit 0

echo "pre-commit: Spotless formatted these staged files. Review the changes, stage them and commit again:" >&2
printf '%s\n' "$after" | while IFS= read -r line; do
  printf '%s\n' "$before" | grep -Fxq -- "$line" || echo "  ${line#* }" >&2
done
exit 1
