<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="LogToConsole" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] [%X{traceId},%X{spanId}] %-5level %logger{36} - %msg%n"/>
    </Console>
    <File name="LogToFile" fileName="logs/application.log">
      <PatternLayout>
        <Pattern>%d %p %c{1.} [%t] [%X{traceId},%X{spanId}] %m%n</Pattern>
      </PatternLayout>
    </File>
    <OpenTelemetry name="LogToOpenTelemetry" captureMapMessageAttributes="true" captureContextDataAttributes="*"/>
  </Appenders>
  <Loggers>
    <Logger name="io.eventdriven.ecommerce" level="debug" additivity="false">
      <AppenderRef ref="LogToFile"/>
      <AppenderRef ref="LogToConsole"/>
      <AppenderRef ref="LogToOpenTelemetry"/>
    </Logger>
    <Logger name="io.eventdriven.core" level="debug" additivity="false">
      <AppenderRef ref="LogToFile"/>
      <AppenderRef ref="LogToConsole"/>
      <AppenderRef ref="LogToOpenTelemetry"/>
    </Logger>
    <Root level="error">
      <AppenderRef ref="LogToFile"/>
      <AppenderRef ref="LogToConsole"/>
      <AppenderRef ref="LogToOpenTelemetry"/>
    </Root>
  </Loggers>
</Configuration>
