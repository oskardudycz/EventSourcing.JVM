<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="LogToConsole" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    <File name="LogToFile" fileName="logs/test.log" append="true">
      <PatternLayout>
        <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
      </PatternLayout>
    </File>
    <OpenTelemetry name="LogToOpenTelemetry" captureMapMessageAttributes="true" captureContextDataAttributes="*"/>
  </Appenders>
  <Loggers>
    <Logger name="io.eventdriven.ecommerce" level="debug" additivity="false">
      <AppenderRef ref="LogToFile"/>
      <AppenderRef ref="LogToOpenTelemetry"/>
    </Logger>
    <Logger name="io.eventdriven.core" level="debug" additivity="false">
      <AppenderRef ref="LogToFile"/>
      <AppenderRef ref="LogToOpenTelemetry"/>
    </Logger>
    <Logger name="org.springframework.kafka" level="debug" additivity="false">
      <AppenderRef ref="LogToFile"/>
    </Logger>
    <Logger name="org.springframework.amqp" level="debug" additivity="false">
      <AppenderRef ref="LogToFile"/>
    </Logger>
    <Root level="error">
      <AppenderRef ref="LogToConsole"/>
    </Root>
  </Loggers>
</Configuration>
