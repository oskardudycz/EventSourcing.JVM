    {
      "id": 6,
      "type": "timeseries",
      "title": "Orders by outcome",
      "description": "How orders move: placed, confirmed (payment authorized and stock reserved), completed, canceled or closed unpaid.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (eventdriven_event_type) (increase(eventdriven_event_appending_count_total{eventdriven_event_type=~\"OrderPlaced|OrderConfirmed|OrderCompleted|OrderCanceled|OrderClosedUnpaid\"}[$__interval]))",
          "legendFormat": "{{eventdriven_event_type}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "links": [
        {
          "title": "Open the traces in Tempo",
          "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20span.eventdriven.command.type%20%3D%20%5C%22PlaceOrder%5C%22%20%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 7,
