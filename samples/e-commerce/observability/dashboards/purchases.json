    {
      "id": 11,
      "type": "timeseries",
      "title": "Failed commands",
      "description": "Commands that threw: conflicts that ran out of retries, failing appends or bugs. Each one is in Tempo with its exception.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (eventdriven_command_type) (increase(eventdriven_command_handling_count_total{eventdriven_command_status=\"failure\"}[$__interval]))",
          "legendFormat": "{{eventdriven_command_type}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "links": [
        {
          "title": "Open the traces in Tempo",
          "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20name%20%3D%20%5C%22command.handle%5C%22%20%26%26%20status%20%3D%20error%20%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Append conflicts",
      "description": "Appends refused because another writer appended first. A few are normal; many mean hot streams.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (eventdriven_eventstore_append_status) (increase(eventdriven_eventstore_append_milliseconds_count{eventdriven_eventstore_append_status!=\"success\"}[$__interval]))",
          "legendFormat": "{{eventdriven_eventstore_append_status}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Timeouts",
      "description": "Customers who didn't pay in time, authorizations that ran out before the capture, and orders closed unpaid.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (eventdriven_event_type) (increase(eventdriven_event_appending_count_total{eventdriven_event_type=~\"PaymentTimedOut|PaymentAuthorizationExpired|OrderClosedUnpaid\"}[$__interval]))",
          "legendFormat": "{{eventdriven_event_type}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Dead letters",
      "description": "Messages a queue gave up on after its retries. They wait in the queue's dead-letter topic or queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_destination_name, message_type) (increase(messaging_dead_lettered_total[$__interval]))",
          "legendFormat": "{{messaging_destination_name}} {{message_type}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Failed message handlers",
      "description": "Kafka and RabbitMQ listener calls that threw. The bus retries them, then dead-letters them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_source_name) (increase(spring_kafka_listener_milliseconds_count{error!=\"none\"}[$__interval]))",
          "legendFormat": "kafka {{messaging_source_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_destination_name) (increase(spring_rabbit_listener_milliseconds_count{error!=\"none\"}[$__interval]))",
          "legendFormat": "rabbitmq {{messaging_destination_name}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Subscription lag",
      "description": "How long after its append each subscription handled an event: the 95th percentile and the worst case. A growing lag means a subscription falls behind its events, for example because a handler fails and is retried.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, eventdriven_subscription_name) (rate(eventdriven_subscription_lag_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{eventdriven_subscription_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (eventdriven_subscription_name) (eventdriven_subscription_lag_milliseconds_max)",
          "legendFormat": "max {{eventdriven_subscription_name}}",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
