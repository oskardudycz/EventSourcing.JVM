    {
      "id": 8,
      "type": "timeseries",
      "title": "Payments",
      "description": "Payments authorized and captured, and the ones that failed: capture failures, timeouts, expired authorizations and cancellations.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (eventdriven_event_type) (increase(eventdriven_event_appending_count_total{eventdriven_event_type=~\"PaymentAuthorized|PaymentCaptured|PaymentCaptureFailed|PaymentTimedOut|PaymentAuthorizationExpired|PaymentCanceled\"}[$__interval]))",
          "legendFormat": "{{eventdriven_event_type}}",
          "range": true,
          "instant": false
