          },
          "expr": "sum by (eventdriven_event_type) (increase(eventdriven_event_appending_count_total{eventdriven_event_type=~\"StockReserved|PackageWasSent|PackageWasDelivered|ProductWasOutOfStock|FulfillmentRejected|StockReleased\"}[$__interval]))",
          "legendFormat": "{{eventdriven_event_type}}",
