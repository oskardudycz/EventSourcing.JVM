    {
      "id": 14,
      "type": "timeseries",
      "title": "Dead letters",
      "description": "Messages a queue gave up on after its retries. They wait in the queue's dead-letter topic or queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
